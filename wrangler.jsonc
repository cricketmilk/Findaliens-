{
  // Cloudflare Workers config — serves the site as static assets, no build step.
  "name": "findaliens",
  "compatibility_date": "2026-08-31",
  "assets": {
    "directory": "./"
  },
  "routes": [
    { "pattern": "findaliens.net", "custom_domain": true },
    { "pattern": "www.findaliens.net", "custom_domain": true }
  ]
}
